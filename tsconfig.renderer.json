{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "outDir": "dist/renderer",
    "rootDir": "src",
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/renderer/**/*", "src/shared/**/*"]
}
